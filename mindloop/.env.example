# ---------------------------------------------------------------------------
# MindLoop configuration. Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# Secrets — generate your own:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
# Fernet key for encrypting journal text, messages, transcripts and memory at rest.
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Required in production. In development an insecure key is derived from JWT_SECRET.
ENCRYPTION_KEY=

POSTGRES_USER=mindloop
POSTGRES_PASSWORD=mindloop
POSTGRES_DB=mindloop

# --- Models (all local, no paid APIs). Change these to swap models — no code changes. ---
# Run Ollama in Docker (default). To use the host's Ollama instead (faster on Apple Silicon):
#   COMPOSE_PROFILES=
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
COMPOSE_PROFILES=ollama
OLLAMA_BASE_URL=http://ollama:11434
MODEL_CHAT=qwen3:4b-instruct
MODEL_EXTRACTION=qwen3:4b-instruct
MODEL_EMBEDDING=nomic-embed-text
# Must match the embedding model's output size (nomic-embed-text = 768). Changing it
# requires a migration of vector columns — see docs/MODELS.md.
EMBEDDING_DIM=768
# faster-whisper model: tiny | base | small | medium | large-v3 (bigger = slower, more accurate)
MODEL_STT=base
LLM_ENABLED=true
EMBEDDINGS_ENABLED=true

# Limits
MAX_AUDIO_SECONDS=120
MAX_AUDIO_BYTES=8388608

# Web / CORS
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false

# Development users (demo@mindloop.example / mindloop-demo-1234). Set false in production.
SEED_DEMO=true

# Host ports (container-internal ports are fixed)
POSTGRES_PORT=55432
API_PORT=8000
WEB_PORT=3000
OLLAMA_PORT=11435
